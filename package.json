{
  "name": "loui-ds",
  "version": "0.4.0",
  "description": "Loui DS: a dark, minimal, functional React design system.",
  "license": "MIT",
  "author": "xraz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrazai/loUI.git"
  },
  "homepage": "https://xrazai.github.io/loUI/",
  "bugs": {
    "url": "https://github.com/xrazai/loUI/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "react-aria",
    "components",
    "dark",
    "accessibility",
    "design-tokens"
  ],
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./manifest.json": "./dist/manifest.json",
    "./tokens.json": "./dist/tokens.json",
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./changes.json": "./dist/changes.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "storybook dev -p 6006",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dev:lib": "tsdown --config-loader tsx --watch",
    "build": "tsdown --config-loader tsx && pnpm manifest:build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:a11y": "vitest run --project storybook && vitest run --project browser -t axe",
    "test:visual": "vitest run --project visual",
    "test:visual:update": "vitest run --project visual --update",
    "visual:pull-linux": "node scripts/visual/pull-linux-baselines.mjs",
    "tokens:build": "tz build && tsx scripts/tokens/studio.ts",
    "tokens:studio": "tsx scripts/tokens/studio.ts",
    "tokens:check": "node scripts/tokens/check.mjs && tsx scripts/tokens/studio.ts --check",
    "figma:parity": "tsx scripts/figma/parity.ts",
    "codemod": "tsx scripts/codemods/run.ts",
    "manifest:build": "tsx scripts/manifest/build.ts",
    "manifest:check": "tsx scripts/manifest/build.ts --check && tsx src/recipes/sync.ts --check",
    "check": "pnpm tokens:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:tools && pnpm build",
    "check:ci": "pnpm tokens:check && pnpm lint && pnpm typecheck && vitest run --project unit --project browser --project storybook && pnpm test:tools && pnpm build && pnpm manifest:check && pnpm test:treeshake && pnpm api:check",
    "changeset": "changeset",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints styles.css llms.txt llms-full.txt",
    "prepare": "husky",
    "test:tools": "pnpm -r --filter \"./tools/*\" test",
    "api:check": "node scripts/api/run.mjs",
    "api:update": "node scripts/api/run.mjs --update",
    "test:treeshake": "node scripts/build/treeshake.mjs",
    "examples:verify": "node scripts/examples/verify.mjs",
    "changeset:version": "node scripts/release/version.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "lucide-react": "~1.66.0",
    "react-aria-components": "1.22.1",
    "react-stately": "3.51.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "7.60.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-a11y": "~10.6.5",
    "@storybook/addon-docs": "~10.6.5",
    "@storybook/addon-mcp": "~10.6.5",
    "@storybook/addon-vitest": "~10.6.5",
    "@storybook/react-vite": "~10.6.5",
    "@terrazzo/cli": "~2.10.0",
    "@terrazzo/plugin-css": "~2.10.0",
    "@tsdown/css": "^0.23.4",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "~5.0.5",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "eslint": "~10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-loui": "workspace:*",
    "eslint-plugin-react-hooks": "~7.1.1",
    "fast-check": "^4.10.2",
    "geist": "1.9.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscodeshift": "^17.4.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "19.3.1",
    "rolldown": "1.2.16",
    "size-limit": "^14.3.0",
    "storybook": "~10.6.5",
    "stylelint": "~17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "~1.12.1",
    "tsdown": "~0.23.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vite": "~8.3.5",
    "vitest": "~5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
