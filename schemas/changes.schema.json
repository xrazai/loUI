{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loui.dev/schemas/changes.schema.json",
  "title": "Loui DS change index",
  "description": "What changed per release and which known gaps are still open (loui-ds/changes.json, generated by scripts/manifest/changes.ts).",
  "type": "object",
  "required": ["schemaVersion", "package", "version", "releases", "unreleased", "open"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": { "type": "string" },
    "version": {
      "type": "string",
      "description": "Version of the package that contains this file."
    },
    "releases": {
      "type": "array",
      "description": "Newest first.",
      "items": {
        "type": "object",
        "required": ["version", "date", "entries"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
        }
      }
    },
    "unreleased": {
      "type": "array",
      "description": "Finished since the last release; not in any published version yet.",
      "items": { "$ref": "#/$defs/entry" }
    },
    "open": {
      "type": "array",
      "description": "Backlog items not done yet, as of this build.",
      "items": {
        "type": "object",
        "required": ["id", "priority", "size", "title", "summary", "components"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "size": { "enum": ["S", "M", "L"] },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "kind", "summary", "components", "internal", "breaking"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Task id, for example GAP-014. Match consumer notes on it."
        },
        "kind": {
          "enum": ["added", "changed", "fixed", "removed", "deprecated", "security", "other"]
        },
        "summary": { "type": "string" },
        "components": { "type": "array", "items": { "type": "string" } },
        "internal": {
          "type": "boolean",
          "description": "Repository-only work with no effect on consumers."
        },
        "breaking": {
          "type": "boolean",
          "description": "The entry carries a **Breaking:** marker: a default, layout, type or behavior changed in a way existing code can notice. The summary says what to do."
        }
      }
    }
  }
}
