{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loui.dev/schemas/tokens.schema.json",
  "title": "Loui DS token manifest",
  "description": "Generated by scripts/manifest/build.ts from src/tokens/generated/tokens.json and src/tokens/contrast-pairs.json. Do not edit by hand.",
  "type": "object",
  "required": ["$schema", "schemaVersion", "package", "generator", "counts", "notes", "tokens"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "generator": { "type": "string" },
    "counts": {
      "type": "object",
      "required": ["tokens", "pairs"],
      "additionalProperties": false,
      "properties": {
        "tokens": { "type": "integer", "minimum": 1 },
        "pairs": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "tokens": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token" } }
  },
  "$defs": {
    "pairing": {
      "type": "object",
      "required": ["on", "ratio", "min", "passes", "source"],
      "additionalProperties": false,
      "properties": {
        "on": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "ratio": { "type": "number", "minimum": 1, "maximum": 21 },
        "min": { "type": "number" },
        "passes": { "type": "boolean" },
        "source": { "enum": ["checked", "computed"] },
        "usage": { "type": "string" }
      }
    },
    "token": {
      "type": "object",
      "required": ["name", "cssVar", "value", "cssValue", "type", "tier", "aliasOf", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "cssVar": { "type": ["string", "null"], "pattern": "^--ds-[a-z0-9-]+$" },
        "value": { "type": "string" },
        "cssValue": { "type": "string" },
        "type": { "type": "string" },
        "tier": { "enum": ["primitive", "semantic", "core"] },
        "aliasOf": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 1 },
        "pairings": {
          "type": "object",
          "required": ["allowed", "notAllowed"],
          "additionalProperties": false,
          "properties": {
            "allowed": { "type": "array", "items": { "$ref": "#/$defs/pairing" } },
            "notAllowed": { "type": "array", "items": { "$ref": "#/$defs/pairing" } }
          }
        },
        "foregrounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["token", "ratio", "min"],
            "additionalProperties": false,
            "properties": {
              "token": { "type": "string" },
              "ratio": { "type": "number" },
              "min": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
