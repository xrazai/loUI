{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loui.dev/schemas/manifest.schema.json",
  "title": "Loui DS component manifest",
  "description": "Generated by scripts/manifest/build.ts from the TypeScript sources, TSDoc, messages, CSS Modules, stories and <Name>.md docs. Do not edit by hand.",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "package",
    "generator",
    "entryPoints",
    "counts",
    "components",
    "providers",
    "hooks",
    "utilities",
    "icons",
    "reexports"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "generator": { "type": "string" },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "importPath", "description"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "importPath": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["components", "hooks", "utilities", "icons"],
      "additionalProperties": false,
      "properties": {
        "components": { "type": "integer", "minimum": 0 },
        "hooks": { "type": "integer", "minimum": 0 },
        "utilities": { "type": "integer", "minimum": 0 },
        "icons": { "type": "integer", "minimum": 0 }
      }
    },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "providers": { "type": "array", "items": { "$ref": "#/$defs/provider" } },
    "hooks": { "type": "array", "items": { "$ref": "#/$defs/function" } },
    "utilities": { "type": "array", "items": { "$ref": "#/$defs/function" } },
    "icons": {
      "type": "object",
      "required": ["entryPoint", "source", "description", "names"],
      "additionalProperties": false,
      "properties": {
        "entryPoint": { "type": "string" },
        "source": { "type": "string" },
        "description": { "type": "string" },
        "names": { "type": "array", "items": { "type": "string", "pattern": "Icon$" } }
      }
    },
    "reexports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "from"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "from": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "status": { "enum": ["experimental", "stable", "deprecated"] },
    "prop": {
      "type": "object",
      "required": ["name", "type", "required", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "description": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "inheritedGroup": {
      "type": "object",
      "required": ["source", "interface", "domGeneric", "count"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "interface": { "type": "string" },
        "domGeneric": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 1 },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "required"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["key", "kind"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "kind": { "enum": ["string", "function"] },
        "default": { "type": "string" },
        "signature": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "story": {
      "type": "object",
      "required": ["name", "id", "hasPlay"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+--[a-z0-9-]+$" },
        "description": { "type": "string" },
        "hasPlay": { "type": "boolean" }
      }
    },
    "docSection": {
      "type": "object",
      "required": ["id", "heading", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "heading": { "type": "string" },
        "content": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "entryPoint",
        "importStatement",
        "folder",
        "sourceFile",
        "status",
        "statusSource",
        "description",
        "props",
        "inheritedProps",
        "variants",
        "cssVariables",
        "stories",
        "docs",
        "related"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "kind": { "const": "component" },
        "entryPoint": { "enum": ["@loui/ds", "@loui/ds/patterns"] },
        "importStatement": { "type": "string" },
        "folder": { "type": "string" },
        "sourceFile": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "statusSource": { "enum": ["jsdoc", "doc", "default"] },
        "description": { "type": "string" },
        "props": { "type": "array", "items": { "$ref": "#/$defs/prop" } },
        "inheritedProps": { "type": "array", "items": { "$ref": "#/$defs/inheritedGroup" } },
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variant": { "type": "array", "items": { "type": "string" } },
            "size": { "type": "array", "items": { "type": "string" } },
            "tone": { "type": "array", "items": { "type": "string" } }
          }
        },
        "messages": {
          "type": "object",
          "required": ["locales", "keys"],
          "additionalProperties": false,
          "properties": {
            "providerKey": { "type": "string" },
            "locales": {
              "type": "array",
              "items": { "type": "string" },
              "contains": { "const": "en" }
            },
            "keys": { "type": "array", "items": { "$ref": "#/$defs/message" } }
          }
        },
        "cssVariables": {
          "type": "array",
          "items": { "type": "string", "pattern": "^--ds-[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "stories": {
          "type": "object",
          "required": ["title", "tags", "items"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "items": { "type": "array", "items": { "$ref": "#/$defs/story" } }
          }
        },
        "docs": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": [
                "path",
                "summary",
                "whenToUse",
                "whenNotToUse",
                "keyboard",
                "examples",
                "sections"
              ],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "summary": { "type": "string" },
                "whenToUse": { "type": "array", "items": { "type": "string" } },
                "whenNotToUse": { "type": "array", "items": { "type": "string" } },
                "keyboard": { "type": "array", "items": { "type": "string" } },
                "examples": { "type": "array", "items": { "type": "string" } },
                "sections": { "type": "array", "items": { "$ref": "#/$defs/docSection" } }
              }
            }
          ]
        },
        "related": {
          "type": "object",
          "required": ["alternatives", "uses", "usedBy"],
          "additionalProperties": false,
          "properties": {
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "reason"],
                "additionalProperties": false,
                "properties": { "name": { "type": "string" }, "reason": { "type": "string" } }
              }
            },
            "uses": { "type": "array", "items": { "type": "string" } },
            "usedBy": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "entryPoint",
        "importStatement",
        "sourceFile",
        "status",
        "description",
        "props",
        "docs"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "kind": { "const": "provider" },
        "entryPoint": { "type": "string" },
        "importStatement": { "type": "string" },
        "sourceFile": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "description": { "type": "string" },
        "props": { "type": "array", "items": { "$ref": "#/$defs/prop" } },
        "docs": { "type": "string" }
      }
    },
    "function": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "entryPoint",
        "importStatement",
        "sourceFile",
        "description",
        "signature",
        "params",
        "returns",
        "docs"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["hook", "utility", "constant"] },
        "entryPoint": { "type": "string" },
        "importStatement": { "type": "string" },
        "sourceFile": { "type": "string" },
        "description": { "type": "string" },
        "signature": { "type": "string" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "required"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        },
        "returns": { "type": "string" },
        "docs": { "type": "string" }
      }
    }
  }
}
