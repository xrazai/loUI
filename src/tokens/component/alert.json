{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "alert": {
    "success-bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.372549, 0.831373, 0.603922],
        "alpha": 0.06,
        "hex": "#5FD49A"
      },
      "$description": "Background of a success Alert: 6% success over the surface beneath, resolved with color-mix. Not for text.",
      "$extensions": {
        "com.loui-ds": {
          "mix": {
            "color": "color.success",
            "percent": 6
          }
        }
      }
    },
    "success-border": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.372549, 0.831373, 0.603922],
        "alpha": 0.3,
        "hex": "#5FD49A"
      },
      "$description": "Border of a success Alert: 30% success over the surface beneath, resolved with color-mix. Not for text.",
      "$extensions": {
        "com.loui-ds": {
          "mix": {
            "color": "color.success",
            "percent": 30
          }
        }
      }
    },
    "warning-bg": {
